# Phase 7 database hardening
# Keep the database administrator credentials OUT of runtime application config.

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=zerodha

# Dedicated runtime account created during Phase 7.
MYSQL_APP_USER=zerodha_app
MYSQL_APP_PASSWORD=root

# Optional pool tuning
MYSQL_CONNECTION_LIMIT=10
MYSQL_QUEUE_LIMIT=0
MYSQL_KEEPALIVE_INITIAL_DELAY_MS=10000
MYSQL_CONNECT_TIMEOUT_MS=10000

# Existing application settings remain below this section.
# JWT_SECRET=...
# FRONTEND_ORIGINS=http://localhost:3002,http://localhost:5173
