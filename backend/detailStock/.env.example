PORT=3011
FRONTEND_ORIGIN=http://localhost:3000,http://localhost:3001
UPSTOX_ACCESS_TOKEN=PUT_YOUR_UPSTOX_ACCESS_TOKEN_HERE
UPSTOX_STREAM_MODE=full
REDIS_URL=redis://127.0.0.1:6379
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=zerodha
MYSQL_ENABLED=false
MARKET_TIMEZONE=Asia/Kolkata
MARKET_OPEN=09:15
MARKET_CLOSE=15:30
CLOSE_JOB_TIME=15:35
HISTORY_CACHE_SECONDS=60
SNAPSHOT_CACHE_SECONDS=86400

# Optional startup reconciliation after market close
RECONCILE_ON_STARTUP=true
# Comma-separated keys to reconcile on startup when market is closed
STARTUP_INSTRUMENT_KEYS=NSE_EQ|INE020B01018
